rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- Public catalog data: readable by anyone, writable by admins only ----
    match /media/{mediaId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sliders/{sliderId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // ---- User requests: anyone can submit, only admins can read/manage ----
    match /requests/{requestId} {
      allow create: if request.resource.data.movieName is string &&
                       request.resource.data.movieName.size() > 0 &&
                       request.resource.data.status == "pending";
      allow read, update, delete: if isAdmin();
    }

    // ---- Admin registry: no client writes at all (managed via Firebase console / Admin SDK) ----
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Site settings (e.g. social links): public read, any authenticated
    // write. In this app the only way to obtain an authenticated session at
    // all is via an admin account created in Firebase Auth (see README —
    // there's no public sign-up flow), so `request.auth != null` is
    // equivalent in practice to admin-only. ----
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
